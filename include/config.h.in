#pragma once

// ---------------- Wi-Fi ----------------
// List every known network. On boot the device scans and connects to the
// known entry with the strongest signal. Copy this file to config.h and
// fill in your real credentials — config.h is gitignored.
struct WifiCred { const char* ssid; const char* pass; };
static const WifiCred WIFI_CREDS[] = {
    {"SSID_1", "PASS_1"},
    {"SSID_2", "PASS_2"},
};

// ---------------- MQTT -----------------
#define MQTT_HOST       "broker.example.com"
#define MQTT_PORT       8883
#define MQTT_USER       ""
#define MQTT_PASS       ""
#define MQTT_TOPIC      "esp32cam-ai/events"
#define MQTT_PLATES_TOPIC "esp32cam-ai/plates"
#define MQTT_CLIENT_ID  "esp32cam-ai"

// ---------------- AI backend -----------
// Comment out USE_GEMINI to use Claude as primary (instead of Gemini).
// When USE_GEMINI is set, Claude Haiku is used as a fallback if Gemini fails.
#define USE_GEMINI

// Claude — always present (primary when USE_GEMINI is not set, fallback otherwise).
#define CLAUDE_API_HOST       "api.anthropic.com"
#define CLAUDE_API_PATH       "/v1/messages"
#define CLAUDE_API_KEY        "sk-ant-REPLACE_ME"
#define CLAUDE_HAIKU_MODEL    "claude-haiku-4-5-20251001"

#ifdef USE_GEMINI
#define GEMINI_API_KEY        "REPLACE_ME"
#define GEMINI_MODEL          "gemini-2.5-flash"
#define GEMINI_PLATES_MODEL   "gemini-2.5-flash-lite"
#else
#define CLAUDE_MODEL          "claude-sonnet-4-6"
#define CLAUDE_PLATES_MODEL   CLAUDE_HAIKU_MODEL
#endif

// ---------------- Capture --------------
// Ring buffer holds the most recent PRE_FRAMES; on a motion trigger we also
// record POST_FRAMES afterward, so each AVI contains PRE_FRAMES + POST_FRAMES.
#define PRE_FRAMES        30
#define POST_FRAMES       60

// Frames sampled (evenly) from each AVI for the AI API call.
#define CLAUDE_SAMPLE_FRAMES  4

// Motion detection: pixel-difference threshold as a percentage of the frame.
// A frame whose downsampled luma differs from the previous by more than this
// fraction of pixels triggers a recording.
#define MOTION_THRESHOLD_PCT  5

// SD card path for recordings and summaries.
#define SD_RECORDINGS_DIR     "/recordings"

// ---------------- Cloud upload -----------
// Hostname of your OCI upload receiver (no https:// prefix).
// Set UPLOAD_TOKEN to the same secret configured in nginx.
#define UPLOAD_HOST   "your-oci-hostname.example.com"
#define UPLOAD_PORT   443
#define UPLOAD_TOKEN  "REPLACE_ME"
