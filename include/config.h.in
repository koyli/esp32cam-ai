#pragma once

// ---------------- Wi-Fi ----------------
// List every known network. On boot the device scans and connects to the
// known entry with the strongest signal. Copy this file to config.h and
// fill in your real credentials — config.h is gitignored.
struct WifiCred { const char* ssid; const char* pass; };
static const WifiCred WIFI_CREDS[] = {
    {"SSID_1", "PASS_1"},
    {"SSID_2", "PASS_2"},
};

// ---------------- Wi-Fi extender ---------
// Uncomment to also run a Wi-Fi access point that forwards (NATs) its clients'
// traffic over the upstream connection above. The AP follows the upstream
// channel, and its subnet (EXTENDER_IP/24) must differ from the upstream one.
// Expect a few Mbit/s shared between the AP clients and the camera's uploads.
// #define EXTENDER_SSID         "esp32cam-ext"
// #define EXTENDER_PASS         "CHANGE_ME_8+chars"
// #define EXTENDER_IP           192, 168, 71, 1
// #define EXTENDER_MAX_CLIENTS  4     // ESP32 allows up to 10

// ---------------- Trail cameras ---------
// Uncomment to also collect photos and videos from Wi-Fi trail cameras
// (GardePro E7/E8 style, see github.com/koyli/trailcam). At each hour in
// TRAILCAM_HOURS (UTC), and once at boot, the device wakes every camera whose
// Bluetooth name or address starts with a TRAILCAM_BLE_MATCH entry, joins its
// "CAM..." Wi-Fi, copies new files to TRAILCAM_SD_DIR and deletes them from the
// camera, then uploads them to the server's trail-camera folder. Motion capture
// pauses, and the upstream link (and any extender clients) drops, while it runs.
// #define TRAILCAM_WIFI_PASS   "CAMERA_WIFI_PASSWORD"
// #define TRAILCAM_BLE_MATCH   "G_E7", "G_E8"
// #define TRAILCAM_HOURS       0, 6, 12, 18
// #define TRAILCAM_SD_DIR      "/trailcam"   // uploaded files move to <dir>/sent
// #define TRAILCAM_BLE_SCAN_S  30

// ---------------- MQTT -----------------
#define MQTT_HOST       "broker.example.com"
#define MQTT_PORT       8883
#define MQTT_USER       ""
#define MQTT_PASS       ""
#define MQTT_TOPIC      "esp32cam-ai/events"
#define MQTT_PLATES_TOPIC "esp32cam-ai/plates"
#define MQTT_CLIENT_ID  "esp32cam-ai"

// ---------------- AI backend -----------
// Comment out USE_GEMINI to use Claude as primary (instead of Gemini).
// When USE_GEMINI is set, Claude Haiku is used as a fallback if Gemini fails.
#define USE_GEMINI

// Claude — always present (primary when USE_GEMINI is not set, fallback otherwise).
#define CLAUDE_API_HOST       "api.anthropic.com"
#define CLAUDE_API_PATH       "/v1/messages"
#define CLAUDE_API_KEY        "sk-ant-REPLACE_ME"
#define CLAUDE_HAIKU_MODEL    "claude-haiku-4-5"

#ifdef USE_GEMINI
#define GEMINI_API_KEY        "REPLACE_ME"
#define GEMINI_MODEL          "gemini-2.5-flash"
#define GEMINI_PLATES_MODEL   "gemini-2.5-flash-lite"
#else
#define CLAUDE_MODEL          "claude-sonnet-5-5"
// Extra request fields and beta header sent with CLAUDE_MODEL requests only.
// between_tools turns off extended thinking (thinking would count against the
// small max_tokens and isn't needed for a short JSON summary); fallbacks lets
// the API retry a refusal on another model. Both are Sonnet 5.5-specific:
// set both to "" if you change CLAUDE_MODEL.
#define CLAUDE_MODEL_PARAMS   "\"thinking\":{\"type\":\"between_tools\"},\"fallbacks\":\"default\","
#define CLAUDE_MODEL_BETA     "server-side-fallback-2026-07-01"
#define CLAUDE_PLATES_MODEL   CLAUDE_HAIKU_MODEL
#endif

// ---------------- Capture --------------
// Ring buffer holds the most recent PRE_FRAMES; on a motion trigger we also
// record POST_FRAMES afterward, so each AVI contains PRE_FRAMES + POST_FRAMES.
#define PRE_FRAMES        30
#define POST_FRAMES       60

// Frames sampled (evenly) from each AVI for the AI API call.
#define CLAUDE_SAMPLE_FRAMES  4

// Motion detection: pixel-difference threshold as a percentage of the frame.
// A frame whose downsampled luma differs from the previous by more than this
// fraction of pixels triggers a recording.
#define MOTION_THRESHOLD_PCT  5

// SD card path for recordings and summaries.
#define SD_RECORDINGS_DIR     "/recordings"

// ---------------- Cloud upload -----------
// Hostname of your OCI upload receiver (no https:// prefix).
// Set UPLOAD_TOKEN to the same secret as in server/upload-token.map.
#define UPLOAD_HOST   "your-oci-hostname.example.com"
#define UPLOAD_PORT   443
#define UPLOAD_TOKEN  "REPLACE_ME"

// ---------------- TLS ------------------
// Servers are verified against the root CAs in include/ca_certs.h (Google Trust
// Services for the AI APIs, Let's Encrypt for the upload server). If your MQTT
// broker or upload host uses a different CA, give its root cert (PEM) here:
// #define MQTT_CA_CERT   "-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
// #define UPLOAD_CA_CERT "-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
// Uncomment to skip certificate verification entirely (not recommended: anyone
// on the network path can read your API keys and upload token).
// #define TLS_INSECURE
